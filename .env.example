# --- Obligatoire -------------------------------------------------------------
# Jeton d'accès à l'app (16 caractères minimum). Génère-en un :
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MOB_TOKEN=

# --- Notifications (ntfy) ----------------------------------------------------
# Serveur ntfy : https://ntfy.sh (public) ou ton propre serveur ntfy.
NTFY_URL=https://ntfy.sh
# Nom du « canal » auquel ton téléphone s'abonne. Sur ntfy.sh il est public :
# choisis-le long et aléatoire, ex. mobilite-k3j9x2m8q1w7
NTFY_TOPIC=
# Jeton d'accès ntfy, seulement si ton serveur ntfy est protégé.
NTFY_TOKEN=
# Adresse publique de CETTE app (https). Sert aux boutons « Ouvrir » et « Fait »
# des notifications. Sans elle, les notifications n'ont pas de boutons.
PUBLIC_URL=https://mobilite.example.org

# --- Réglages ----------------------------------------------------------------
MOB_TZ=Europe/Paris
MOB_HOST=127.0.0.1
MOB_PORT=8080
# Mets 1 si l'app est derrière un reverse proxy (Caddy, nginx) : l'IP réelle
# est alors lue dans X-Forwarded-For pour la limitation des tentatives.
MOB_TRUST_PROXY=1
# MOB_DB=./data/mobilite.db
