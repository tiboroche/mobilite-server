# /etc/nginx/sites-available/mobilite
# Certificat : sudo certbot certonly --nginx -d mobilite.example.org
# Activation : sudo ln -s /etc/nginx/sites-available/mobilite /etc/nginx/sites-enabled/
#              sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name mobilite.example.org;

    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name mobilite.example.org;

    ssl_certificate     /etc/letsencrypt/live/mobilite.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mobilite.example.org/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        # Avec MOB_TRUST_PROXY=1, le serveur lit la 1re IP de X-Forwarded-For pour limiter les
        # tentatives : on la remplace par l'IP réelle au lieu d'ajouter à celle du client.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
